Builder, BuildError = std.build
build = (b :: Builder) Res<(), BuildError> {
    tls  = b.lib(
        "tls",
        {src: Path("../zen-openssl/src/tls.zen"), libs: ["ssl", "crypto"], paths: ["build/openssl/lib"]}
    ).try();
    http = b.lib(
        "http",
        {src: Path("src/http/http.zen"), libs: [], paths: []}
    ).try();
    b.exe(
        "echo",
        {src: Path("examples/echo.zen"), deps: [http, tls], out: Ok(Path("build/zen-server"))}
    ).try();
    b.exe(
        "echo-h2",
        {src: Path("examples/echo_h2.zen"), deps: [http, tls], out: Ok(Path("build/zen-h2-server"))}
    ).try();
    Ok(())
}
