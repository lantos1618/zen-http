// Compatibility adapter for the OpenSSL-backed transport.
Alloc, Ptr = std.mem
Sink = std.core.io
Range = std.core
Transport, read = tls
HttpError, HttpResponseMeta, http_error = http.client_types
parse_response*, parse_response_into* = http.response_decode
decode_response_into = http.response_decode

read_response_into* = (s: Transport, a: Alloc, out :: Sink)
                      Res<HttpResponseMeta, HttpError> {
    chunk ::= a.Vec<u8>();
    decode_response_into(
        (buffer: Ptr<u8>, count: usize) Res<usize, HttpError> {
            got = s.read(chunk, count).match({
                Ok(n)  => Ok(n),
                Err(e) => e.match({Closed => Ok(0), _ => Err(http_error(e))}),
            }).try();
            Range(0, got).loop((i) { buffer.write(i, chunk.ptr().read(i)); });
            Ok(got)
        }, a, out
    )
}
