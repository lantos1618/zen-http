// Certificate/plaintext wrapper around the shared HTTP parser and reactor.
ServerContext, TlsFault = tls
Ptr, null_ptr = std.mem
serve_with, TransportBackend = http.server_core
ServerError*, Request*, Status*, Response*, Handler* = http.server_core
zen_http_listen, zen_http_listener_close, zen_http_accept, zen_http_close,
    zen_http_listener_fd, zen_http_fd, transport_io, resume_read,
    transport_requested, transport_armed, transport_mark_armed = http.transport
Options* = { host*: str, port*: u16, tls*: bool, certificate*: str, private_key*: str }
OpenSslBackend = { context: Ptr<()> }
OpenSslBackend.impl(TransportBackend, {
    listen = (self :: @Self, a: Alloc, host: Ptr<u8>, port: u16) Ptr<()> { zen_http_listen(
        a,
        host,
        port,
        self.context
    ) }
    listener_close = (self :: @Self, handle: Ptr<()>) { zen_http_listener_close(
        handle
    ) }
    accept = (self :: @Self, listener: Ptr<()>) Ptr<()> { zen_http_accept(
        listener
    ) }
    close = (self :: @Self, handle: Ptr<()>) { zen_http_close(handle) }
    listener_fd = (self :: @Self, listener: Ptr<()>) i32 { zen_http_listener_fd(
        listener
    ) }
    fd = (self :: @Self, handle: Ptr<()>) i32 { zen_http_fd(handle) }
    io = (self :: @Self, handle: Ptr<()>, bytes: Ptr<u8>, len: usize, writing: i32) i64 { transport_io(
        handle,
        bytes,
        len,
        writing
    ) }
    finish = (self :: @Self, handle: Ptr<()>) i64 { 1 }
    resume_read = (self :: @Self, handle: Ptr<()>) i32 { resume_read(handle) }
    requested = (self :: @Self, handle: Ptr<()>) i32 { transport_requested(
        handle
    ) }
    armed = (self :: @Self, handle: Ptr<()>) i32 { transport_armed(handle) }
    mark_armed = (self :: @Self, handle: Ptr<()>, interest: i32) { transport_mark_armed(
        handle,
        interest
    ) }
})
serve* = (a: Alloc, options: Options, handler :: Handler) Res<(), AllocError
    | ServerError> {
    (!options.host.contains(0) && !options.certificate.contains(0) && !options.private_key.contains(0)).ensure(ServerError.Listen).try();
    context = options.tls.match({
        true  => ServerContext.create(
            a,
            options.certificate,
            options.private_key
        ).try(ServerError.Listen),
        false => ServerContext(handle: null_ptr<()>()),
    });
    backend ::= OpenSslBackend(context: context.handle);
    serve_with(a, options.host, options.port, backend, handler)
}
