// Borrowed native layout; Zen owns I/O decisions and readiness transitions.
ServerIo, server_io, server_pending, server_h2_selected = tls
Alloc, Ptr, null_ptr = std.mem
server_session, server_free = tls

// Handles borrow their allocator and TLS context. The caller closes each handle
// once, before releasing either owner; copying a handle does not transfer it.
Transport* = {
    alloc*: Alloc,
    fd*: i32,
    ssl*: Ptr<()>,
    want* :: i32,
    armed* :: i32,
}
Listener = { alloc: Alloc, fd: i32, context: Ptr<()> }
SockAddr = c.record("transport.h", "struct sockaddr_in", {
    sin_port: u16,
})
Setup = c.bind("transport.h", {
    AF_INET: i32
    SOCK_STREAM: i32
    SOL_SOCKET: i32
    SO_REUSEADDR: i32
    SO_NOSIGPIPE: i32 = 0
    IPPROTO_TCP: i32
    TCP_NODELAY: i32
    F_GETFL: i32
    F_SETFL: i32
    F_GETFD: i32
    F_SETFD: i32
    O_NONBLOCK: i32
    FD_CLOEXEC: i32
    socket = (family: i32, kind: i32, protocol: i32) i32
    accept = (fd: i32, address: Ptr<()>, count: Ptr<u32>) i32
    close = (fd: i32) i32
    fcntl = (fd: i32, command: i32, flags: i32) i32
    setsockopt = (fd: i32, level: i32, option: i32, value: Ptr<()>, count: u32) i32
    inet_pton = (family: i32, host: Ptr<c_char>, address: Ptr<()>) i32
    zen_http_ipv4_family = (address: Ptr<()>, family: i32) ()
    zen_http_ipv4_address = (address: Ptr<()>) Ptr<()>
    htons = (port: u16) u16
    bind = (fd: i32, address: Ptr<()>, count: usize) i32
    listen = (fd: i32, backlog: i32) i32
})

SetupError = Allocation | Socket

with_flag = (flags: i32, bit: i32) i32 {
    ((flags / bit) % 2 == 0).match({true => flags + bit, false => flags})
}
configure = (a: Alloc, fd: i32) Res<(), SetupError> {
    option = a.raw(4, 4).try(SetupError.Allocation).to<i32>();
    @scope.defer(() { a.free(option); });
    option.write(0, 1);
    flags = Setup.fcntl(fd, Setup.F_GETFL, 0);
    bits  = Setup.fcntl(fd, Setup.F_GETFD, 0);
    (flags >= 0 && bits >= 0).ensure(SetupError.Socket).try();
    (Setup.fcntl(fd, Setup.F_SETFL, with_flag(flags, Setup.O_NONBLOCK)) == 0
        && Setup.fcntl(
            fd,
            Setup.F_SETFD,
            with_flag(bits, Setup.FD_CLOEXEC)
        ) == 0)
        .ensure(SetupError.Socket).try();
    (Setup.SO_NOSIGPIPE != 0).then(() {
        (Setup.setsockopt(
            fd,
            Setup.SOL_SOCKET,
            Setup.SO_NOSIGPIPE,
            option.to<()>(),
            4
        ) == 0)
            .ensure(SetupError.Socket).try();
    });
    (Setup.setsockopt(
        fd,
        Setup.IPPROTO_TCP,
        Setup.TCP_NODELAY,
        option.to<()>(),
        4
    ) == 0)
        .ensure(SetupError.Socket)
}
listen_address = (
    a    : Alloc,
    fd   : i32,
    host : Ptr<u8>,
    port : u16
) Res<(), SetupError> {
    address = a.raw(
        null_ptr<SockAddr>().bytes(1),
        16
    ).try(SetupError.Allocation).to<SockAddr>();
    @scope.defer(() { a.free(address); });
    address.write(0, SockAddr(sin_port: Setup.htons(port)));
    Setup.zen_http_ipv4_family(address.to<()>(), Setup.AF_INET);
    (Setup.inet_pton(
        Setup.AF_INET,
        host.to<c_char>(),
        Setup.zen_http_ipv4_address(address.to<()>())
    ) == 1)
        .ensure(SetupError.Socket).try();
    option = a.raw(4, 4).try(SetupError.Allocation).to<i32>();
    @scope.defer(() { a.free(option); });
    option.write(0, 1);
    (Setup.setsockopt(
        fd,
        Setup.SOL_SOCKET,
        Setup.SO_REUSEADDR,
        option.to<()>(),
        4
    ) == 0)
        .ensure(SetupError.Socket).try();
    configure(a, fd).try();
    size = address.bytes(1);
    (Setup.bind(fd, address.to<()>(), size) == 0 && Setup.listen(fd, 256) == 0)
        .ensure(SetupError.Socket)
}
zen_http_listen* = (
    a       : Alloc,
    host    : Ptr<u8>,
    port    : u16,
    context : Ptr<()>
) Ptr<()> {
    fd = Setup.socket(Setup.AF_INET, Setup.SOCK_STREAM, 0);
    (fd < 0).match({
        true  => null_ptr<()>(),
        false => listen_address(a, fd, host, port).match({
            Err(_) => { Setup.close(fd); null_ptr<()>() },
            Ok(_)  => a.raw(null_ptr<Listener>().bytes(1), 16).match({
                Err(_)  => { Setup.close(fd); null_ptr<()>() },
                Ok(raw) => {
                    raw.to<Listener>().write(
                        0,
                        Listener(alloc: a, fd: fd, context: context)
                    ); raw.to<()>()
                },
            }),
        }),
    })
}
zen_http_listener_fd* = (handle: Ptr<()>) i32 { handle.to<Listener>().read(
    0
).fd }
zen_http_fd* = (handle: Ptr<()>) i32 { handle.to<Transport>().read(0).fd }
zen_http_listener_close* = (handle: Ptr<()>) {
    listener = handle.to<Listener>().read(0);
    Setup.close(listener.fd); listener.alloc.free(handle);
}
zen_http_close* = (handle: Ptr<()>) {
    transport = handle.to<Transport>().read(0);
    server_free(transport.ssl); Setup.close(transport.fd); transport.alloc.free(handle);
}
accepted = (listener: Listener, fd: i32) Res<Ptr<()>, SetupError> {
    configure(listener.alloc, fd).try();
    raw = listener.alloc.raw(
        null_ptr<Transport>().bytes(1),
        16
    ).try(SetupError.Allocation);
    ssl = listener.context.is_null().match({
        true => null_ptr<()>(), false => server_session(listener.context, fd),
    });
    (listener.context.is_null() || !ssl.is_null()).match({
        false => { listener.alloc.free(raw); Err(SetupError.Socket) },
        true  => {
            raw.to<Transport>().write(
                0,
                Transport(
                    alloc: listener.alloc,
                    fd: fd,
                    ssl: ssl,
                    want: Native.POLLIN,
                    armed: 0
                )
            );
            Ok(raw.to<()>())
        },
    })
}
zen_http_accept* = (handle: Ptr<()>) Ptr<()> {
    listener = handle.to<Listener>().read(0);
    fd       = Setup.accept(listener.fd, null_ptr<()>(), null_ptr<u32>());
    (fd < 0).match({
        true  => null_ptr<()>(),
        false => accepted(listener, fd).match({
            Ok(transport) => transport,
            Err(_)        => { Setup.close(fd); null_ptr<()>() },
        }),
    })
}

Native = c.bind("transport.h", {
    POLLIN: i32
    POLLOUT: i32
    EAGAIN: i32
    EWOULDBLOCK: i32
    EINTR: i32
    MSG_NOSIGNAL: i32 = 0
    zen_http_errno = () i32
    send = (fd: i32, bytes: Ptr<u8>, len: usize, flags: i32) i64
    recv = (fd: i32, bytes: Ptr<u8>, len: usize, flags: i32) i64
})
transport_io* = (
    handle  : Ptr<()>,
    bytes   : Ptr<u8>,
    len     : usize,
    writing : i32
) i64 {
    pointer = handle.to<Transport>();
    transport ::= pointer.read(0);
    transport.want = (writing != 0).match({true => Native.POLLOUT, false => Native.POLLIN});
    result         = transport.ssl.is_null().match({
        false => server_io(transport.ssl, bytes, len, writing != 0).match({
            Bytes(n)  => n,
            WantRead  => { transport.want = Native.POLLIN; -2 },
            WantWrite => { transport.want = Native.POLLOUT; -2 },
            Closed    => -1,
        }),
        true  => {
            n = (writing != 0).match({
                true  => Native.send(
                    transport.fd,
                    bytes,
                    len,
                    Native.MSG_NOSIGNAL
                ),
                false => Native.recv(transport.fd, bytes, len, 0),
            });
            (n > 0).match({
                true  => n,
                false => {
                    error = Native.zen_http_errno();
                    (n < 0 && (error == Native.EAGAIN || error == Native.EWOULDBLOCK || error == Native.EINTR)).match({true => -2, false => -1})
                },
            })
        },
    });
    pointer.write(0, transport);
    result
}
resume_read* = (handle: Ptr<()>) i32 {
    pointer = handle.to<Transport>();
    transport ::= pointer.read(0);
    transport.want = Native.POLLIN;
    pointer.write(0, transport);
    server_pending(transport.ssl).match({true => 1, false => 0})
}

transport_h2_selected* = (handle: Ptr<()>) bool {
    transport = handle.to<Transport>().read(0);
    server_h2_selected(transport.ssl)
}

// Readiness metadata stays in Zen; no C wrappers for field access.
transport_requested* = (handle: Ptr<()>) i32 { handle.to<Transport>().read(
    0
).want }
transport_armed* = (handle: Ptr<()>) i32 { handle.to<Transport>().read(
    0
).armed }
transport_mark_armed* = (handle: Ptr<()>, interest: i32) {
    pointer = handle.to<Transport>();
    transport ::= pointer.read(0);
    transport.armed = interest;
    pointer.write(0, transport);
}
