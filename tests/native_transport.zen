Pool, PoolAlloc, PoolPolicy = std.mem.mem_pool
NativeBackend = http.native_transport
TransportBackend = http.server_core
Socket = std.net.socket
TestAddr = c.record("transport.h", "struct sockaddr_in", { sin_port: u16 })
Probe = c.bind("native_transport_probe.h", {
    F_GETFD: i32
    fcntl = (fd: i32, command: i32, value: i32) i32
    getsockname = (fd: i32, address: Ptr<()>, size: Ptr<u32>) i32
    ntohs = (value: u16) u16
    usleep = (micros: u32) i32
    interrupt_read = () ()
    fail_entropy = (enabled: i32) ()
    entropy_calls = () i32
})
Failure = Setup | Incorrect
FaultAlloc = { base: Alloc, calls: Ptr<usize>, live: Ptr<usize>, fail: Ptr<usize> }
FaultAlloc.impl(Alloc, {
    raw = (self: @Self, count: usize, align: usize) Res<Ptr<u8>, AllocError> {
        current = self.calls.read(0); self.calls.write(0, current + 1);
        (current != self.fail.read(0)).ensure(AllocError.OutOfMemory).try();
        result = self.base.raw(count, align).try();
        self.live.write(0, self.live.read(0) + 1); Ok(result)
    }
    realloc = <T>(self: @Self, pointer: Ptr<T>, count: usize) Res<Ptr<T>, AllocError> {
        pointer.is_null().ensure(AllocError.OutOfMemory).try();
        p = self.raw(pointer.bytes(count), 16).try(); Ok(p.to<T>())
    }
    free = <T>(self: @Self, pointer: Ptr<T>) {
        self.live.write(0, self.live.read(0) - 1); self.base.free(pointer);
    }
})
fd_count = () usize {
    count: usize ::= 0; fd: i32 ::= 0;
    loop(() { fd < 256 }, (h) {
        (Probe.fcntl(fd, Probe.F_GETFD, 0) >= 0).then(() { count = count + 1; }); fd = fd + 1;
    }); count
}
exercise = (backend :: TransportBackend, a: Alloc, pooled: Alloc) Res<(), AllocError
    | Failure> {
    counters = a.raw(24, 8).try().to<usize>();
    @scope.defer(() { a.free(counters); });
    calls = counters; live = counters.offset(1); fail = counters.offset(2);
    calls.write(0, 0); live.write(0, 0); fail.write(0, usize.MAX);
    allocator = FaultAlloc(base: pooled, calls: calls, live: live, fail: fail);
    host      = "127.0.0.1".c_text(a).try();
    initial   = fd_count();
    listener  = backend.listen(allocator, host.ptr(), 0);
    (!listener.is_null()).ensure(Failure.Setup).try();
    @scope.defer(() { backend.listener_close(listener); });
    (live.read(0) == 1).ensure(Failure.Incorrect).try();
    address = a.raw(null_ptr<TestAddr>().bytes(1), 16).try().to<TestAddr>();
    @scope.defer(() { a.free(address); });
    size = a.raw(4, 4).try().to<u32>();
    @scope.defer(() { a.free(size); }); size.write(0, 16);
    (Probe.getsockname(backend.listener_fd(listener), address.to<()>(), size) == 0).ensure(Failure.Setup).try();
    port = Probe.ntohs(address.read(0).sin_port);
    // Every allocation involved in configuring/owning the accepted session.
    Range(0, 8).loop((cut) {
        client ::= Socket.tcp_connect(a, "127.0.0.1", port).try(Failure.Setup);
        baseline = fd_count(); calls.write(0, 0); fail.write(0, cut);
        attempt ::= 0;
        loop(() { calls.read(0) <= cut && attempt < 100 }, (h) {
            rejected = backend.accept(listener);
            rejected.is_null().ensure(Failure.Incorrect).try();
            attempt = attempt + 1; Probe.usleep(1000);
        });
        (calls.read(0) > cut && live.read(0) == 1 && fd_count() == baseline).ensure(Failure.Incorrect).try();
        client.close();
    });
    fail.write(0, usize.MAX);
    // Both entropy failures must close the accepted fd and free all workspace.
    Range(1, 3).loop((cut) {
        client ::= Socket.tcp_connect(a, "127.0.0.1", port).try(Failure.Setup);
        baseline = fd_count(); calls.write(0, 0); Probe.fail_entropy(cut.to_u64().to_i32().value_or(0));
        attempt ::= 0;
        loop(() { calls.read(0) == 0 && attempt < 100 }, (h) {
            backend.accept(listener).is_null().ensure(Failure.Incorrect).try();
            attempt = attempt + 1; Probe.usleep(1000);
        });
        (Probe.entropy_calls() == cut.to_u64().to_i32().value_or(0) && live.read(0) == 1 && fd_count() == baseline).ensure(Failure.Incorrect).try();
        client.close();
    });
    Probe.fail_entropy(0);
    client   ::= Socket.tcp_connect(a, "127.0.0.1", port).try(Failure.Setup);
    accepted ::= null_ptr<()>(); attempts ::= 0;
    loop(() { accepted.is_null() && attempts < 100 }, (h) {
        accepted = backend.accept(listener); attempts = attempts + 1; Probe.usleep(1000);
    });
    (!accepted.is_null() && Probe.entropy_calls() == 2).ensure(
        Failure.Incorrect
    ).try();
    bytes = a.raw(16, 8).try(); @scope.defer(() { a.free(bytes); });
    (backend.io(accepted, bytes, 16, 0) == -2).ensure(Failure.Incorrect).try();
    interest = backend.requested(accepted); backend.mark_armed(accepted, interest);
    (interest != 0 && backend.armed(accepted) == interest).ensure(Failure.Incorrect).try();
    Probe.interrupt_read();
    (backend.io(accepted, bytes, 16, 0) == -3).ensure(Failure.Incorrect).try();
    (backend.io(accepted, bytes, 16, 0) == -2).ensure(Failure.Incorrect).try();
    backend.close(accepted); client.close();
    (live.read(0) == 1 && fd_count() == initial + 1).ensure(Failure.Incorrect).try();
    println(
        "PASS native adapter: allocation/entropy failures, independent randomness, EAGAIN/injected EINTR, readiness and cancelled-handshake cleanup"
    );
    Ok(())
}
main = (env: Env) Res<(), AllocError | Failure> {
    a = env.mem.alloc(); psk = a.raw(32, 8).try();
    @scope.defer(() { a.free(psk); }); Range(0, 32).loop((i) { psk.write(i, 42); });
    backend ::= NativeBackend(identity: "test", psk: psk, psk_count: 32);
    pool = a.raw(null_ptr<Pool>().bytes(1), 16).try().to<Pool>(); pool.write(0, Pool());
    @scope.defer(() { owner ::= pool.read(0); owner.close(); a.free(pool); });
    pooled = PoolAlloc(
        pool: pool,
        policy: PoolPolicy(cache_bytes: 65536, block_bytes: 1024, blocks: 512)
    );
    exercise(backend, a, pooled)
}
